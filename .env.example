# NextIT Supabase PostgreSQL Connection
# Obtain these from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> JDBC / URI

# Option A: Direct Connection (Port 5432)
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Option B: Connection Pooler (Recommended for cloud/serverless, Port 6543)
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
# SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Fallback (Local MySQL / Embedded MariaDB if no Supabase environment variables are provided):
# NEXTIT_DB_URL=jdbc:mysql://localhost:3306/nextit?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# NEXTIT_DB_USER=root
# NEXTIT_DB_PASSWORD=

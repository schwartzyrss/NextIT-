# Copy this file to .env and fill in your local MySQL credentials.
# Environment variables and JVM system properties with the same names take priority.
# Do not commit real credentials.
NEXTIT_DB_URL=jdbc:mysql://localhost:3306/nextit?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
NEXTIT_DB_USER=root
NEXTIT_DB_PASSWORD=yourpassword
